{
  "name": "remoteclaude-system-integration-tests",
  "version": "1.0.0",
  "description": "Comprehensive system integration testing suite for RemoteClaudeApp",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:websocket": "jest --testPathPattern=websocket",
    "test:ui": "jest --testPathPattern=ui",
    "test:mobile": "detox test",
    "test:web": "jest --testPathPattern=web",
    "test:live": "jest --testPathPattern=live",
    "test:full": "npm run test:websocket && npm run test:ui && npm run test:integration",
    "test:report": "node scripts/generateReport.js",
    "setup:test-env": "node scripts/setupTestEnvironment.js",
    "start:test-server": "node test-server/index.js",
    "live-test": "ts-node src/cli/liveCLI.ts",
    "live-test:run": "ts-node src/cli/liveCLI.ts run",
    "live-test:monitor": "ts-node src/cli/liveCLI.ts monitor",
    "live-test:check": "ts-node src/cli/liveCLI.ts check",
    "live-test:config": "ts-node src/cli/liveCLI.ts config",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "testing",
    "integration",
    "react-native",
    "websocket",
    "automation"
  ],
  "author": {
    "name": "Takaya Suetake",
    "email": "Takaya.suetake16c1050@gmail.com",
    "github": "suetaketakaya"
  },
  "license": "MIT",
  "dependencies": {
    "appium": "^2.2.3",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "detox": "^20.13.5",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "inquirer": "^8.2.6",
    "moment": "^2.29.4",
    "ora": "^5.4.1",
    "puppeteer": "^21.6.1",
    "react-native-testing-library": "^6.0.0",
    "selenium-webdriver": "^4.15.0",
    "uuid": "^9.0.1",
    "webdriverio": "^8.24.12",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setup/testSetup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.{js,ts}",
      "<rootDir>/tests/**/*.test.{js,ts}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts",
      "!src/setup/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "RemoteClaudeApp Test Report",
          "outputPath": "./reports/test-report.html",
          "includeFailureMsg": true,
          "includeSuiteFailure": true
        }
      ]
    ]
  },
  "detox": {
    "testRunner": "jest",
    "runnerConfig": "e2e/config.json",
    "configurations": {
      "ios.sim.debug": {
        "type": "ios.simulator",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/RemoteClaudeApp.app",
        "build": "xcodebuild -workspace ios/RemoteClaudeApp.xcworkspace -scheme RemoteClaudeApp -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
        "device": {
          "type": "iPhone 14"
        }
      },
      "android.emu.debug": {
        "type": "android.emulator",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug",
        "device": {
          "avdName": "Pixel_5_API_31"
        }
      }
    }
  }
}
